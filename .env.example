# Docker Compose environment (read automatically by `docker compose`).
#
#   cp .env.example .env
#   # then set SECRET_KEY
#   docker compose up --build
#
# Application-level settings for running the backend *outside* Docker live in
# backend/.env.example.

# --- database credentials (also used to build DATABASE_URL for the backend) ---
POSTGRES_USER=lakewatch
POSTGRES_PASSWORD=lakewatch
POSTGRES_DB=lakewatch

# --- REQUIRED -----------------------------------------------------------------
# The backend refuses to start without this.  Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=change-me-generate-a-long-random-value
SECRET_KEY=
ENVIRONMENT=production

# --- optional bootstrap administrator ----------------------------------------
# Alternatively run `docker compose exec backend python -m app.cli bootstrap-admin`.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=

# --- background workers -------------------------------------------------------
JOBS_WORKER_COUNT=2
