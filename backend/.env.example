# LakeWatch - environment template.
#
# Copy to `backend/.env` for local development, or set these variables in your
# container/orchestrator.  Every value below is read by
# `backend/app/core/config.py` (pydantic-settings, `.env` supported).

# ---------------------------------------------------------------- application
APP_NAME="LakeWatch API"
ENVIRONMENT=development

# ---------------------------------------------------------------- database
# PostgreSQL + PostGIS is the primary target.  `docker compose up db` exposes
# PostGIS on localhost:5432 with the credentials below.
DATABASE_URL=postgresql+psycopg://lakewatch:lakewatch@localhost:5432/lakewatch
#
# Zero-configuration fallback for local development and the test suite:
# DATABASE_URL=sqlite:///./dev.db

# Development convenience.  Set both to false in production and run
# `alembic upgrade head` before starting the API.
AUTO_CREATE_TABLES=true
STARTUP_BOOTSTRAP=true

# ---------------------------------------------------------------- security
# REQUIRED in production.  Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=insecure-dev-secret-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------- bootstrap admin
# Consumed by `python -m app.cli bootstrap-admin`.  Leave blank to be prompted.
# The password must be at least 10 characters.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=

# ---------------------------------------------------------------- storage
# Root for raw retrievals, processed products and exports (shared volume in
# docker-compose; maps to the `storage` service volume).
STORAGE_ROOT=../data/storage

# ---------------------------------------------------------------- background jobs
JOBS_ENABLED=true
JOBS_POLL_INTERVAL_SECONDS=2.0
JOBS_WORKER_COUNT=2
JOBS_MAX_ATTEMPTS=3

# ---------------------------------------------------------------- HTTP / providers
# All seven provider adapters use open endpoints (Microsoft Planetary Computer
# STAC + SAS, USGS LP DAAC, CHC CHIRPS, NASA POWER); no API keys are required.
HTTP_TIMEOUT_SECONDS=30.0
CHIRPS_BASE_URL=https://data.chc.ucsb.edu/products/CHIRPS-2.0
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api
PLANETARY_COMPUTER_STAC_URL=https://planetarycomputer.microsoft.com/api/stac/v1
PLANETARY_COMPUTER_SAS_URL=https://planetarycomputer.microsoft.com/api/sas/v1
LPDAAC_STAC_URL=https://data.lpdaac.earthdatacloud.nasa.gov/stac/LPCLOUD

# ---------------------------------------------------------------- dashboard AI assistant
# OpenAI-compatible chat completions endpoint. Leave blank to keep the assistant disabled.
# Examples:
#   OpenAI: https://api.openai.com/v1
#   Gemini OpenAI-compatible API: https://generativelanguage.googleapis.com/v1beta/openai
#   Ollama in Docker: http://host.docker.internal:11434/v1
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_SECONDS=45

# ---------------------------------------------------------------- CORS
# Comma-separated.  Must include the browser origin serving the frontend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
